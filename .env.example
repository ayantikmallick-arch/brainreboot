# ==========================================
# BrainFlow AI - Configuration Template
# ==========================================

# Rotato Server URL
# Important: On local development, Rotato runs at http://localhost:8990
# For production deployment, set this to a publicly accessible Rotato URL (e.g., via Cloudflare Tunnel, ngrok, or a hosted VPS).
ROTATO_BASE_URL=http://localhost:8990

# Preferred default provider (groq | openrouter | cloudflare)
ROTATO_DEFAULT_PROVIDER=groq

# Preferred default model (e.g. openai/gpt-oss-20b for Groq, openrouter/free for OpenRouter, @cf/meta/llama-3.2-3b-instruct for Cloudflare)
ROTATO_DEFAULT_MODEL=openai/gpt-oss-20b

# Timeout per provider attempt (in ms)
ROTATO_TIMEOUT_MS=30000

# Optional Rotato Admin / Proxy bearer token (if configured)
ROTATO_API_KEY=

# ==========================================
# Resend Email Delivery Configuration
# ==========================================
# Added in Vercel Environment Variables:
RESEND_API_KEY=re_your_resend_api_key_here

# ==========================================
# Server-Side OTP Encryption Secret
# ==========================================
# Random 32+ character secret used to encrypt pending registration payloads:
OTP_ENCRYPTION_SECRET=your_random_32_character_secret_key_here

# ==========================================
# Firebase Client Configuration
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ==========================================
# Firebase Admin SDK Configuration (Server-Side)
# ==========================================
# Option 1: Full service account JSON as a string (recommended for Vercel):
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option 2: Individual service account credentials:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
